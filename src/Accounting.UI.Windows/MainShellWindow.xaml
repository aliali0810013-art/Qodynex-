<Window x:Class="Accounting.UI.Windows.MainShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Accounting.UI.Windows"
        Title="كودينكس المحاسبي - QODYNEX ERP" Width="1540" Height="940" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" PreviewKeyDown="OnPreviewKeyDown">

  <Window.Resources>
    <DataTemplate x:Key="IconTemplate">
      <Viewbox Width="20" Height="20"><Path Data="{Binding}" Stroke="{StaticResource GoldBrush}" StrokeThickness="1.7" Stretch="Uniform"/></Viewbox>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="لوحة القيادة" FontSize="28" FontWeight="Bold"/>
              <TextBlock Text="{Binding CompanyName}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Style="{StaticResource PrimaryButton}" Content="+ فاتورة مبيعات" Command="{Binding OpenSaleCommand}"/>
              <Button Content="+ سند قبض" Command="{Binding OpenReceiptCommand}"/>
              <Button Content="تحديث" Command="{Binding RefreshCommand}"/>
            </StackPanel>
          </Grid>
          <UniformGrid Columns="5">
            <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="مبيعات اليوم" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding SalesTotal, StringFormat={}{0:N2}}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"/><TextBlock Text="{Binding Currency}" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
            <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="الصندوق والبنوك" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding CashBalance, StringFormat={}{0:N2}}" FontSize="26" FontWeight="Bold"/><TextBlock Text="{Binding Currency}" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
            <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="قيمة المخزون" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding InventoryValue, StringFormat={}{0:N2}}" FontSize="26" FontWeight="Bold"/><TextBlock Text="{Binding Currency}" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
            <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="عدد الأصناف" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding ItemCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BlueBrush}"/><TextBlock Text="صنف فعّال" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
            <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="Outbox" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding PendingOutbox}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource OrangeBrush}"/><TextBlock Text="عملية تنتظر المزامنة" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
          </UniformGrid>
          <Border Style="{StaticResource CardBorder}" Margin="6,14,6,6">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock Text="آخر 10 قيود مرحّلة" FontSize="18" FontWeight="SemiBold" Margin="4,0,4,10"/>
              <DataGrid Grid.Row="1" ItemsSource="{Binding RecentJournals}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="التاريخ" Binding="{Binding DateUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="170"/>
                  <DataGridTextColumn Header="المرجع" Binding="{Binding Reference}" Width="150"/>
                  <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*"/>
                  <DataGridTextColumn Header="مدين" Binding="{Binding Debit, StringFormat={}{0:N2}}" Width="130"/>
                  <DataGridTextColumn Header="دائن" Binding="{Binding Credit, StringFormat={}{0:N2}}" Width="130"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
          <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" Margin="8"/>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:InvoiceEditorViewModel}">
      <Grid Margin="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorder}" IsEnabled="{Binding IsEditable}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="4"><TextBlock Text="المستودع" Foreground="{StaticResource MutedBrush}" Margin="2,0,2,4"/><ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}" DisplayMemberPath="Name"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="4"><TextBlock Text="طريقة الدفع" Foreground="{StaticResource MutedBrush}" Margin="2,0,2,4"/><ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}"/></StackPanel>
            <StackPanel Grid.Column="2" Margin="4">
              <TextBlock Text="{Binding PartnerLabel}" Foreground="{StaticResource MutedBrush}" Margin="2,0,2,4"/>
              <ComboBox ItemsSource="{Binding Partners}" SelectedItem="{Binding SelectedPartner}" DisplayMemberPath="Name" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name"/>
              <Button Content="{Binding QuickPartnerButtonLabel}" Click="OnQuickPartnerClick" Padding="8,4" MinHeight="30"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="4"><TextBlock Text="حساب التسوية" Foreground="{StaticResource MutedBrush}" Margin="2,0,2,4"/><ComboBox ItemsSource="{Binding SettlementAccounts}" SelectedItem="{Binding SelectedSettlementAccount}" DisplayMemberPath="Name"/></StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}" FontSize="16" ToolTip="باركود / SKU - الماسح يضيف تلقائياً" IsEnabled="{Binding IsEditable}"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableItems}" SelectedItem="{Binding SelectedSearchItem}" DisplayMemberPath="Name"
                      IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name" ToolTip="ابحث باسم الصنف أو اختره" IsEnabled="{Binding IsEditable}"/>
            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="+ إضافة سطر صنف (Insert)" Command="{Binding AddSelectedItemCommand}" IsEnabled="{Binding IsEditable}"/>
            <Button Grid.Column="3" Content="بحث F3" Command="{Binding SearchCommand}"/>
            <Button Grid.Column="4" Content="حذف السطر" Command="{Binding RemoveLineCommand}" IsEnabled="{Binding IsEditable}"/>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Left" Margin="2,6,2,0">
              <Button Style="{StaticResource PrimaryButton}" Content="حفظ وترحيل F5" Command="{Binding SaveCommand}" IsEnabled="{Binding IsEditable}"/>
              <Button Content="+ فاتورة جديدة" Command="{Binding NewDocumentCommand}"/>
              <Button Content="طباعة فاتورة مبسطة (80mm)" Command="{Binding PrintThermalCommand}"/>
              <Button Content="طباعة فاتورة A4 رسمية" Command="{Binding PrintA4Command}"/>
              <Button Content="الفواتير السابقة / مرتجع" Command="{Binding OpenInvoiceHistoryCommand}"/>
            </StackPanel>
          </Grid>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" Margin="6,10"
                  IsReadOnly="False" IsHitTestVisible="{Binding IsEditable}" CanUserAddRows="False" SelectionUnit="CellOrRowHeader">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="الصنف" Width="2*">
              <DataGridTemplateColumn.CellTemplate><DataTemplate>
                <ComboBox ItemsSource="{Binding DataContext.AvailableItems, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                          SelectedItem="{Binding SelectedItem,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                          DisplayMemberPath="Name" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                          SelectionChanged="OnInvoiceLineItemChanged"/>
              </DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" IsReadOnly="True" Width="130"/>
            <DataGridTemplateColumn Header="الوحدة" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate>
              <ComboBox ItemsSource="{Binding UnitOptions}" SelectedItem="{Binding SelectedUnit,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Name"/>
            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:N3}}" Width="110"/>
            <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:N2}}" Width="120"/>
            <DataGridTextColumn Header="الخصم" Binding="{Binding Discount,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:N2}}" Width="110"/>
            <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal,StringFormat={}{0:N2}}" IsReadOnly="True" Width="140"/>
          </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="16,12">
          <Grid MinHeight="74">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="4,4,16,4">
              <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
              <TextBlock Margin="0,6,0,0"><Run Text="رقم المستند: "/><Run Text="{Binding DocumentNumber}" FontWeight="Bold"/><Run Text="   التاريخ: "/><Run Text="{Binding DocumentDate,StringFormat={}{0:yyyy-MM-dd HH:mm}}" FontWeight="Bold"/></TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="12,4"><TextBlock Text="قبل الضريبة" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Subtotal,StringFormat={}{0:N2}}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Grid.Column="2" Margin="12,4"><TextBlock Text="الضريبة" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Tax,StringFormat={}{0:N2}}" FontSize="20" FontWeight="Bold" Padding="0,4"/></StackPanel>
            <StackPanel Grid.Column="3" Margin="12,4"><TextBlock Text="الصافي النهائي" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding GrandTotal,StringFormat={}{0:N2}}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,5,0,0"/></StackPanel>
          </Grid>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:InvoiceHistoryViewModel}">
      <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1.2*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="الفواتير السابقة" FontSize="28" FontWeight="Bold"/><TextBlock Text="عرض المستند المرحّل وإنشاء مرتجع/عكس محاسبي دون تعديل الأصل" Foreground="{StaticResource MutedBrush}"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="تحديث" Command="{Binding RefreshCommand}"/><Button Style="{StaticResource DangerButton}" Content="إنشاء مرتجع / عكس المحدد" Command="{Binding ReverseCommand}"/></StackPanel>
        </Grid>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="النوع" Binding="{Binding Kind}" Width="90"/>
            <DataGridTextColumn Header="الرقم المحلي" Binding="{Binding LocalNumber}" Width="130"/>
            <DataGridTextColumn Header="الرقم الرسمي" Binding="{Binding OfficialNumber}" Width="130"/>
            <DataGridTextColumn Header="التاريخ" Binding="{Binding DateUtc,StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="160"/>
            <DataGridTextColumn Header="الطرف" Binding="{Binding PartnerName}" Width="*"/>
            <DataGridTextColumn Header="الإجمالي" Binding="{Binding Total,StringFormat={}{0:N2}}" Width="130"/>
            <DataGridCheckBoxColumn Header="معكوس" Binding="{Binding IsReversed}" Width="80"/>
          </DataGrid.Columns>
        </DataGrid>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Lines}" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120"/>
            <DataGridTextColumn Header="الصنف" Binding="{Binding Name}" Width="*"/>
            <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" Width="100"/>
            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity,StringFormat={}{0:N3}}" Width="110"/>
            <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice,StringFormat={}{0:N2}}" Width="110"/>
            <DataGridTextColumn Header="الإجمالي" Binding="{Binding Total,StringFormat={}{0:N2}}" Width="130"/>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" Margin="6"/>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:VoucherEditorViewModel}">
      <ScrollViewer><StackPanel Margin="24" MaxWidth="980" HorizontalAlignment="Center">
        <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="Bold" Margin="4,0,4,16"/>
        <Border Style="{StaticResource CardBorder}"><Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="الصندوق / البنك" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding VoucherCashAccounts}" SelectedItem="{Binding SelectedCashAccount}" DisplayMemberPath="Name"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="العميل / المورد" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding VoucherPartners}" SelectedItem="{Binding SelectedVoucherPartner}" DisplayMemberPath="Name"/></StackPanel>
          <StackPanel Grid.Row="1"><TextBlock Text="الحساب المقابل" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding VoucherAccounts}" SelectedItem="{Binding SelectedCounterAccount}" DisplayMemberPath="Name"/></StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="المبلغ" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Amount}" FontSize="20"/></StackPanel>
          <StackPanel Grid.Row="2" Grid.ColumnSpan="2"><TextBlock Text="البيان" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Description}"/></StackPanel>
        </Grid></Border>
        <Button Style="{StaticResource PrimaryButton}" Content="حفظ وترحيل F5" Command="{Binding SaveCommand}" Height="52"/>
        <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="6"/>
      </StackPanel></ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:VouchersWorkspaceViewModel}">
      <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="السندات المالية" FontSize="28" FontWeight="Bold"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource PrimaryButton}" Content="+ سند قبض" Command="{Binding NewReceiptCommand}"/><Button Content="+ سند صرف" Command="{Binding NewPaymentCommand}"/></StackPanel>
        </Grid>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="النوع" Binding="{Binding Kind}" Width="110"/><DataGridTextColumn Header="الرقم المؤقت" Binding="{Binding LocalNumber}" Width="150"/>
            <DataGridTextColumn Header="الرقم الرسمي" Binding="{Binding OfficialNumber}" Width="150"/><DataGridTextColumn Header="التاريخ" Binding="{Binding DateUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="170"/>
            <DataGridTextColumn Header="الطرف" Binding="{Binding PartnerName}" Width="180"/><DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="140"/>
            <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" Margin="6"/>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:InventoryWorkspaceViewModel}">
      <TabControl Margin="14">
        <TabItem Header="الأصناف والأرصدة">
          <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="320"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="المخزون والأصناف" FontSize="28" FontWeight="Bold"/><TextBlock Text="الرصيد الفعلي، الكرتون، WAC وقيمة المخزون" Foreground="{StaticResource MutedBrush}"/></StackPanel>
              <ComboBox Grid.Column="1" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}" DisplayMemberPath="Name"/>
              <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="تحديث" Command="{Binding RefreshCommand}"/><Button Style="{StaticResource PrimaryButton}" Content="كرت الصنف F7" Command="{Binding OpenStockLedgerCommand}"/></StackPanel>
            </Grid>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedItem}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="130"/><DataGridTextColumn Header="الصنف" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" Width="100"/><DataGridTextColumn Header="الرصيد" Binding="{Binding Quantity, StringFormat={}{0:N3}}" Width="120"/>
                <DataGridTextColumn Header="الكرتون" Binding="{Binding CartonText}" Width="230"/><DataGridTextColumn Header="متوسط التكلفة" Binding="{Binding AverageCost, StringFormat={}{0:N2}}" Width="140"/>
                <DataGridTextColumn Header="قيمة المخزون" Binding="{Binding InventoryValue, StringFormat={}{0:N2}}" Width="150"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" Margin="6"/>
          </Grid>
        </TabItem>
        <TabItem Header="إضافة صنف">
          <ScrollViewer><StackPanel Margin="26" MaxWidth="980" HorizontalAlignment="Center">
            <TextBlock Text="إضافة صنف جديد إلى SQLite" FontSize="24" FontWeight="Bold" Margin="4,0,4,14"/>
            <Border Style="{StaticResource CardBorder}"><Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="SKU" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding NewSku,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="اسم الصنف" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding NewName,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel Grid.Row="1"><TextBlock Text="الباركود" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding NewBarcode,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="الوحدة الأساسية" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding BaseUnit}" DisplayMemberPath="Name"/></StackPanel>
              <StackPanel Grid.Row="2"><TextBlock Text="وحدة الكرتون" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding CartonUnit}" DisplayMemberPath="Name"/></StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="1"><TextBlock Text="عدد الوحدات في الكرتون" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding CartonFactor}"/></StackPanel>
              <StackPanel Grid.Row="3"><TextBlock Text="حساب المخزون" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding InventoryAccount}" DisplayMemberPath="Name"/></StackPanel>
              <Grid Grid.Row="3" Grid.Column="1"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SalesAccount}" DisplayMemberPath="Name"/><ComboBox Grid.Row="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding CogsAccount}" DisplayMemberPath="Name"/></Grid>
            </Grid></Border>
            <Button Style="{StaticResource PrimaryButton}" Content="إضافة الصنف" Command="{Binding AddItemCommand}" Height="52"/>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="6"/>
          </StackPanel></ScrollViewer>
        </TabItem>
      </TabControl>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AccountsWorkspaceViewModel}">
      <TabControl Margin="14">
        <TabItem Header="شجرة الحسابات"><DataGrid ItemsSource="{Binding Accounts}">
          <DataGrid.Columns><DataGridTextColumn Header="الكود" Binding="{Binding Code}" Width="120"/><DataGridTextColumn Header="الحساب" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="130"/><DataGridTextColumn Header="الطبيعة" Binding="{Binding NormalBalance}" Width="120"/><DataGridCheckBoxColumn Header="ترحيل" Binding="{Binding IsPostable}" Width="80"/></DataGrid.Columns>
        </DataGrid></TabItem>
        <TabItem Header="قيود اليومية"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DataGrid ItemsSource="{Binding Journals}" SelectedItem="{Binding SelectedJournal}">
            <DataGrid.Columns><DataGridTextColumn Header="التاريخ" Binding="{Binding DateUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="160"/><DataGridTextColumn Header="المرجع" Binding="{Binding Reference}" Width="130"/><DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="المصدر" Binding="{Binding SourceType}" Width="150"/><DataGridTextColumn Header="مدين" Binding="{Binding Debit, StringFormat={}{0:N2}}" Width="120"/><DataGridTextColumn Header="دائن" Binding="{Binding Credit, StringFormat={}{0:N2}}" Width="120"/></DataGrid.Columns>
          </DataGrid>
          <DataGrid Grid.Row="1" ItemsSource="{Binding JournalLines}"><DataGrid.Columns><DataGridTextColumn Header="الكود" Binding="{Binding AccountCode}" Width="120"/><DataGridTextColumn Header="الحساب" Binding="{Binding AccountName}" Width="*"/><DataGridTextColumn Header="البيان" Binding="{Binding Memo}" Width="*"/><DataGridTextColumn Header="مدين" Binding="{Binding Debit, StringFormat={}{0:N2}}" Width="120"/><DataGridTextColumn Header="دائن" Binding="{Binding Credit, StringFormat={}{0:N2}}" Width="120"/></DataGrid.Columns></DataGrid>
          <StackPanel Grid.Row="2" Orientation="Horizontal"><Button Style="{StaticResource DangerButton}" Content="قيد عكسي للمحدد" Command="{Binding ReverseSelectedCommand}"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0"/></StackPanel>
        </Grid></TabItem>
        <TabItem Header="قيد يدوي">
          <Grid Margin="14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="المرجع" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding ManualReference,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="البيان العام" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding ManualDescription,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            </Grid>
            <DataGrid Grid.Row="1" ItemsSource="{Binding ManualLines}" SelectedItem="{Binding SelectedManualLine}" IsReadOnly="False" CanUserAddRows="False">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="الحساب" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <ComboBox ItemsSource="{Binding DataContext.PostableAccounts,RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                            SelectedItem="{Binding Account,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Name"
                            IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name"/>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="مدين" Binding="{Binding Debit,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:N2}}" Width="150"/>
                <DataGridTextColumn Header="دائن" Binding="{Binding Credit,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:N2}}" Width="150"/>
                <DataGridTextColumn Header="بيان السطر" Binding="{Binding Memo,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="2" Orientation="Horizontal">
              <Button Content="+ إضافة سطر (Insert)" Command="{Binding AddManualLineCommand}"/>
              <Button Content="حذف السطر" Command="{Binding RemoveManualLineCommand}"/>
            </StackPanel>
            <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
              <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="ترحيل القيد اليدوي F5" Command="{Binding PostManualCommand}" MinWidth="190"/>
            </Grid>
          </Grid>
        </TabItem>
        <TabItem Header="ميزان المراجعة"><DataGrid ItemsSource="{Binding TrialBalance}">
          <DataGrid.Columns><DataGridTextColumn Header="الكود" Binding="{Binding Code}" Width="120"/><DataGridTextColumn Header="الحساب" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="مدين" Binding="{Binding Debit, StringFormat={}{0:N2}}" Width="150"/><DataGridTextColumn Header="دائن" Binding="{Binding Credit, StringFormat={}{0:N2}}" Width="150"/><DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat={}{0:N2}}" Width="150"/></DataGrid.Columns>
        </DataGrid></TabItem>
      </TabControl>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ReportsSyncViewModel}">
      <TabControl Margin="14">
        <TabItem Header="كشف حساب"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal"><ComboBox Width="360" ItemsSource="{Binding Partners}" SelectedItem="{Binding SelectedPartner}" DisplayMemberPath="Name"/><Button Style="{StaticResource PrimaryButton}" Content="عرض كشف الحساب" Command="{Binding LoadStatementCommand}"/></StackPanel>
          <TextBlock Grid.Row="1" Text="{Binding PartnerBalance}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Margin="8"/>
          <DataGrid Grid.Row="2" ItemsSource="{Binding StatementRows}"><DataGrid.Columns><DataGridTextColumn Header="التاريخ" Binding="{Binding DateUtc, StringFormat={}{0:yyyy-MM-dd}}" Width="130"/><DataGridTextColumn Header="المرجع" Binding="{Binding Reference}" Width="130"/><DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="مدين" Binding="{Binding Debit, StringFormat={}{0:N2}}" Width="120"/><DataGridTextColumn Header="دائن" Binding="{Binding Credit, StringFormat={}{0:N2}}" Width="120"/><DataGridTextColumn Header="الرصيد" Binding="{Binding RunningBalance, StringFormat={}{0:N2}}" Width="140"/></DataGrid.Columns></DataGrid>
        </Grid></TabItem>
        <TabItem Header="ميزان المراجعة"><DataGrid ItemsSource="{Binding TrialBalance}"><DataGrid.Columns><DataGridTextColumn Header="الكود" Binding="{Binding Code}" Width="120"/><DataGridTextColumn Header="الحساب" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="مدين" Binding="{Binding Debit, StringFormat={}{0:N2}}" Width="150"/><DataGridTextColumn Header="دائن" Binding="{Binding Credit, StringFormat={}{0:N2}}" Width="150"/><DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat={}{0:N2}}" Width="150"/></DataGrid.Columns></DataGrid></TabItem>
        <TabItem Header="مركز المزامنة"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SyncSummary}" FontSize="18" FontWeight="Bold"/><Button Grid.Column="1" Content="تحديث" Command="{Binding RefreshCommand}"/></Grid>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Outbox}"><DataGrid.Columns><DataGridTextColumn Header="الحدث" Binding="{Binding EventType}" Width="*"/><DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="إعادات" Binding="{Binding RetryCount}" Width="80"/><DataGridTextColumn Header="الإنشاء" Binding="{Binding CreatedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="170"/></DataGrid.Columns></DataGrid>
          <DataGrid Grid.Row="2" ItemsSource="{Binding Conflicts}" SelectedItem="{Binding SelectedConflict}"><DataGrid.Columns><DataGridTextColumn Header="رمز التعارض" Binding="{Binding Code}" Width="200"/><DataGridTextColumn Header="الرسالة" Binding="{Binding Message}" Width="*"/><DataGridTextColumn Header="وقت الخادم" Binding="{Binding ServerTimestampUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="170"/><DataGridCheckBoxColumn Header="محلول" Binding="{Binding IsResolved}" Width="80"/></DataGrid.Columns></DataGrid>
          <StackPanel Grid.Row="3" Orientation="Horizontal"><Button Style="{StaticResource DangerButton}" Content="تعليم التعارض كمحلول" Command="{Binding ResolveConflictCommand}"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0"/></StackPanel>
        </Grid></TabItem>
      </TabControl>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CompanySettingsViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22" MaxWidth="1180" HorizontalAlignment="Center">
          <TextBlock Text="الإعدادات والكليشة" FontSize="30" FontWeight="Bold" Margin="4,0,4,6"/>
          <TextBlock Text="هوية الشركة وترويسة الفواتير والسياسات المالية المحلية" Foreground="{StaticResource MutedBrush}" Margin="4,0,4,14"/>
          <Border Style="{StaticResource CardBorder}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <StackPanel Grid.RowSpan="3" Margin="8">
                <Border Height="150" BorderBrush="{StaticResource BorderBrushQ}" BorderThickness="1" CornerRadius="10" Background="{StaticResource Bg0Brush}">
                  <Image Source="{Binding LogoPreview}" Stretch="Uniform" Margin="8"/>
                </Border>
                <Button Content="اختيار صورة الشعار Logo" Command="{Binding ChooseLogoCommand}"/>
              </StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="اسم الشركة / المؤسسة (عربي)"/><TextBox Text="{Binding ArabicName,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Company name (English)"/><TextBox Text="{Binding EnglishName,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"><TextBlock Text="النشاط التجاري / الوصف"/><TextBox Text="{Binding BusinessDescription,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="1"><TextBlock Text="المدينة"/><TextBox Text="{Binding City,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="العنوان التفصيلي"/><TextBox Text="{Binding Address,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel Grid.Row="3" Grid.Column="0"><TextBlock Text="الهاتف / الجوال / واتساب"/><TextBox Text="{Binding Phones,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel Grid.Row="3" Grid.Column="1"><TextBlock Text="البريد الإلكتروني"/><TextBox Text="{Binding Email,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel Grid.Row="3" Grid.Column="2"><TextBlock Text="الرقم الضريبي"/><TextBox Text="{Binding TaxNumber,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel Grid.Row="4" Grid.Column="0"><TextBlock Text="السجل التجاري"/><TextBox Text="{Binding CommercialRegistration,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel Grid.Row="4" Grid.Column="1"><TextBlock Text="العملة الأساسية"/><TextBox Text="{Binding CurrencyCode,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel Grid.Row="4" Grid.Column="2"><TextBlock Text="رمز العملة"/><TextBox Text="{Binding CurrencySymbol,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"><CheckBox IsChecked="{Binding TaxEnabled}" Margin="8"/><TextBlock Text="تفعيل الضريبة" VerticalAlignment="Center"/></StackPanel>
              <StackPanel Grid.Row="5" Grid.Column="1"><TextBlock Text="نسبة الضريبة %"/><TextBox Text="{Binding TaxRatePercent,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel Grid.Row="5" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><CheckBox IsChecked="{Binding AllowNegativeStock}" Margin="8"/><TextBlock Text="السماح بالمخزون السالب" VerticalAlignment="Center"/></StackPanel>
              <StackPanel Grid.Row="6" Grid.ColumnSpan="3"><TextBlock Text="ملاحظات تذييل الفاتورة"/><TextBox Text="{Binding FooterNotes,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="80"/></StackPanel>
            </Grid>
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Style="{StaticResource PrimaryButton}" Content="حفظ إعدادات الشركة" Command="{Binding SaveCommand}" MinWidth="180"/>
            <CheckBox IsChecked="{Binding DarkThemeEnabled}" Content="الوضع الليلي محفوظ لهذا الجهاز" VerticalAlignment="Center" Margin="16,0"/>
          </StackPanel>
          <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" Margin="8"/>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:QuickSearchViewModel}">
      <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}" FontSize="17"/><Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="بحث" Command="{Binding SearchCommand}"/></Grid>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Results}"><DataGrid.Columns><DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="120"/><DataGridTextColumn Header="الكود" Binding="{Binding Code}" Width="140"/><DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="تفاصيل" Binding="{Binding Extra}" Width="240"/></DataGrid.Columns></DataGrid>
        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" Margin="6"/>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ItemMovementViewModel}">
      <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding Summary}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Margin="6"/>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}"><DataGrid.Columns><DataGridTextColumn Header="التاريخ" Binding="{Binding DateUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="170"/><DataGridTextColumn Header="المصدر" Binding="{Binding SourceType}" Width="180"/><DataGridTextColumn Header="الكمية" Binding="{Binding QuantityDelta, StringFormat={}{0:N3}}" Width="130"/><DataGridTextColumn Header="القيمة" Binding="{Binding InventoryValueDelta, StringFormat={}{0:N2}}" Width="150"/><DataGridTextColumn Header="تكلفة الوحدة" Binding="{Binding UnitCost, StringFormat={}{0:N2}}" Width="150"/></DataGrid.Columns></DataGrid>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid Background="{StaticResource Bg0Brush}">
    <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrushQ}" BorderThickness="0,0,0,1">
      <Grid Margin="16,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="48" Height="48" Background="{StaticResource Bg0Brush}" BorderBrush="{StaticResource BorderBrushQ}" BorderThickness="1" CornerRadius="12" Margin="0,0,10,0"><Grid><TextBlock Text="Q" Foreground="{StaticResource PrimaryBrush}" FontWeight="Black" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding ProductionLogo}" Stretch="Uniform" Margin="3"/></Grid></Border>
          <StackPanel><TextBlock Text="كودينكس المحاسبي" FontSize="18" FontWeight="Bold"/><TextBlock Text="QODYNEX ERP" Foreground="{StaticResource GoldBrush}" FontSize="11" FontWeight="SemiBold"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Button Content="F2 جديد" Click="OnNewClick"/><Button Content="F3 بحث سريع" Click="OnQuickSearchClick"/><Button Style="{StaticResource PrimaryButton}" Content="F5 حفظ وترحيل" Click="OnSavePostClick"/><Button Content="F7 تفاصيل" Click="OnDetailsClick"/><Button Content="F9 مزامنة الآن" Click="OnSyncNowClick"/><Button Content="🌙 وضع ليلي" Click="OnThemeToggleClick" MinWidth="115"/>
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" MinWidth="230" Margin="12,0,0,0">
          <TextBlock Text="{Binding ProductionCompanyName}" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding BranchName, StringFormat='الفرع: {0}'}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="  •  " Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding ProductionCurrency, StringFormat='العملة: {0}'}" Foreground="{StaticResource GoldBrush}"/></StackPanel>
          <TextBlock Text="{Binding NetworkStatus}" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrushQ}" BorderThickness="0,0,1,0">
        <DockPanel Margin="10">
          <TextBlock DockPanel.Dock="Bottom" Text="SQLite محلي • Offline First" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="10"/>
          <StackPanel>
            <TextBlock Text="التنقل الرئيسي" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="10,8"/>
            <Button Command="{Binding OpenDashboardCommand}"><StackPanel Orientation="Horizontal"><Viewbox Width="20" Height="20"><Path Data="{StaticResource IconDashboard}" Stroke="{StaticResource GoldBrush}" StrokeThickness="1.6"/></Viewbox><TextBlock Text="لوحة القيادة" Margin="12,0,0,0"/></StackPanel></Button>
            <Button Command="{Binding OpenSalesCommand}"><StackPanel Orientation="Horizontal"><Viewbox Width="20" Height="20"><Path Data="{StaticResource IconSales}" Stroke="{StaticResource GoldBrush}" StrokeThickness="1.6"/></Viewbox><TextBlock Text="فواتير المبيعات و POS" Margin="12,0,0,0"/></StackPanel></Button>
            <Button Command="{Binding OpenPurchaseCommand}"><StackPanel Orientation="Horizontal"><Viewbox Width="20" Height="20"><Path Data="{StaticResource IconPurchase}" Stroke="{StaticResource GoldBrush}" StrokeThickness="1.6"/></Viewbox><TextBlock Text="فواتير المشتريات" Margin="12,0,0,0"/></StackPanel></Button>
            <Button Command="{Binding OpenVouchersWorkspaceCommand}"><StackPanel Orientation="Horizontal"><Viewbox Width="20" Height="20"><Path Data="{StaticResource IconVoucher}" Stroke="{StaticResource GoldBrush}" StrokeThickness="1.6"/></Viewbox><TextBlock Text="السندات المالية" Margin="12,0,0,0"/></StackPanel></Button>
            <Button Command="{Binding OpenInventoryWorkspaceCommand}"><StackPanel Orientation="Horizontal"><Viewbox Width="20" Height="20"><Path Data="{StaticResource IconInventory}" Stroke="{StaticResource GoldBrush}" StrokeThickness="1.6"/></Viewbox><TextBlock Text="المخزون والأصناف" Margin="12,0,0,0"/></StackPanel></Button>
            <Button Command="{Binding OpenAccountsWorkspaceCommand}"><StackPanel Orientation="Horizontal"><Viewbox Width="20" Height="20"><Path Data="{StaticResource IconAccounts}" Stroke="{StaticResource GoldBrush}" StrokeThickness="1.6"/></Viewbox><TextBlock Text="الحسابات ودفتر الأستاذ" Margin="12,0,0,0"/></StackPanel></Button>
            <Button Command="{Binding OpenReportsSyncCommand}"><StackPanel Orientation="Horizontal"><Viewbox Width="20" Height="20"><Path Data="{StaticResource IconReports}" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.6"/></Viewbox><TextBlock Text="التقارير والمزامنة" Margin="12,0,0,0"/></StackPanel></Button><Button Command="{Binding OpenSettingsCommand}"><StackPanel Orientation="Horizontal"><Viewbox Width="20" Height="20"><Path Data="{StaticResource IconSettings}" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.6"/></Viewbox><TextBlock Text="الإعدادات والكليشة" Margin="12,0,0,0"/></StackPanel></Button>
            <Separator Margin="8,14"/>
            <Button Content="إغلاق التبويب الحالي" Click="OnCloseTabClick"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <TabControl Grid.Column="1" ItemsSource="{Binding Workspace.Tabs}" SelectedItem="{Binding Workspace.SelectedTab}" Margin="8">
        <TabControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" Margin="8,2" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"/></DataTemplate></TabControl.ItemTemplate>
        <TabControl.ContentTemplate><DataTemplate><ContentPresenter Content="{Binding ViewModel}"/></DataTemplate></TabControl.ContentTemplate>
      </TabControl>
    </Grid>

    <StatusBar Grid.Row="2">
      <StatusBarItem><TextBlock Text="{Binding UserName, StringFormat='المستخدم: {0}'}"/></StatusBarItem><Separator/>
      <StatusBarItem><TextBlock Text="SQLite: متصل"/></StatusBarItem><Separator/>
      <StatusBarItem><TextBlock Text="{Binding SyncStatus}"/></StatusBarItem>
    </StatusBar>
  </Grid>
</Window>