<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
  <Color x:Key="Bg0">#F8FAFC</Color><Color x:Key="Bg1">#FFFFFF</Color>
  <Color x:Key="Card">#FFFFFF</Color><Color x:Key="Border">#CBD5E1</Color>
  <Color x:Key="Primary">#1D4ED8</Color><Color x:Key="Gold">#B7791F</Color>
  <Color x:Key="Orange">#C2410C</Color><Color x:Key="Green">#047857</Color>
  <Color x:Key="Red">#B91C1C</Color><Color x:Key="Blue">#1D4ED8</Color>
  <Color x:Key="Text">#0F172A</Color><Color x:Key="Muted">#475569</Color>
  <Color x:Key="InputBg">#FFFFFF</Color><Color x:Key="HeaderBg">#FFFFFF</Color>
  <Color x:Key="SidebarBg">#F1F5F9</Color><Color x:Key="SelectionBg">#DBEAFE</Color>
  <Color x:Key="SelectionText">#0F172A</Color>

  <SolidColorBrush po:Freeze="False" x:Key="Bg0Brush" Color="{StaticResource Bg0}"/>
  <SolidColorBrush po:Freeze="False" x:Key="Bg1Brush" Color="{StaticResource Bg1}"/>
  <SolidColorBrush po:Freeze="False" x:Key="CardBrush" Color="{StaticResource Card}"/>
  <SolidColorBrush po:Freeze="False" x:Key="BorderBrushQ" Color="{StaticResource Border}"/>
  <SolidColorBrush po:Freeze="False" x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
  <SolidColorBrush po:Freeze="False" x:Key="GoldBrush" Color="{StaticResource Gold}"/>
  <SolidColorBrush po:Freeze="False" x:Key="OrangeBrush" Color="{StaticResource Orange}"/>
  <SolidColorBrush po:Freeze="False" x:Key="GreenBrush" Color="{StaticResource Green}"/>
  <SolidColorBrush po:Freeze="False" x:Key="RedBrush" Color="{StaticResource Red}"/>
  <SolidColorBrush po:Freeze="False" x:Key="BlueBrush" Color="{StaticResource Blue}"/>
  <SolidColorBrush po:Freeze="False" x:Key="TextBrush" Color="{StaticResource Text}"/>
  <SolidColorBrush po:Freeze="False" x:Key="MutedBrush" Color="{StaticResource Muted}"/>
  <SolidColorBrush po:Freeze="False" x:Key="InputBrush" Color="{StaticResource InputBg}"/>
  <SolidColorBrush po:Freeze="False" x:Key="HeaderBrush" Color="{StaticResource HeaderBg}"/>
  <SolidColorBrush po:Freeze="False" x:Key="SidebarBrush" Color="{StaticResource SidebarBg}"/>
  <SolidColorBrush po:Freeze="False" x:Key="SelectionBrush" Color="{StaticResource SelectionBg}"/>
  <SolidColorBrush po:Freeze="False" x:Key="SelectionTextBrush" Color="{StaticResource SelectionText}"/>

  <Geometry x:Key="IconDashboard">M3,3 H11 V11 H3 Z M13,3 H21 V8 H13 Z M13,10 H21 V21 H13 Z M3,13 H11 V21 H3 Z</Geometry>
  <Geometry x:Key="IconSales">M4,4 H20 V20 H4 Z M7,8 H17 M7,12 H17 M7,16 H13</Geometry>
  <Geometry x:Key="IconPurchase">M3,5 H6 L8,15 H18 L21,8 H8 M10,19 A1.5,1.5 0 1 0 10.1,19 M17,19 A1.5,1.5 0 1 0 17.1,19</Geometry>
  <Geometry x:Key="IconVoucher">M4,6 H20 V18 H4 Z M8,10 H16 M8,14 H13</Geometry>
  <Geometry x:Key="IconInventory">M3,7 L12,3 L21,7 L12,11 Z M3,7 V17 L12,21 V11 M21,7 V17 L12,21</Geometry>
  <Geometry x:Key="IconAccounts">M4,4 H20 V8 H4 Z M6,10 H18 V14 H6 Z M8,16 H16 V20 H8 Z</Geometry>
  <Geometry x:Key="IconReports">M5,20 V11 H9 V20 M10,20 V5 H14 V20 M15,20 V8 H19 V20</Geometry>
  <Geometry x:Key="IconSync">M5,8 A8,8 0 0 1 19,7 L21,5 V11 H15 L17,9 A6,6 0 0 0 7,10 M19,16 A8,8 0 0 1 5,17 L3,19 V13 H9 L7,15 A6,6 0 0 0 17,14</Geometry>
  <Geometry x:Key="IconSettings">M12,2 L14,5 L18,5 L19,9 L22,11 L20,15 L21,19 L17,21 L14,20 L12,23 L9,20 L5,21 L3,17 L4,14 L1,11 L4,8 L3,4 L7,3 L9,5 Z M12,9 A3,3 0 1 0 12,15 A3,3 0 1 0 12,9</Geometry>
  <Geometry x:Key="IconAction">M5,12 H19 M14,7 L19,12 L14,17</Geometry>
  <Geometry x:Key="IconAdd">M12,4 V20 M4,12 H20</Geometry>
  <Geometry x:Key="IconSearch">M10.5,4 A6.5,6.5 0 1 0 10.5,17 A6.5,6.5 0 1 0 10.5,4 M15.5,15.5 L21,21</Geometry>
  <Geometry x:Key="IconSave">M4,3 H18 L21,6 V21 H3 V3 Z M7,3 V9 H16 V3 M7,14 H17 V20 H7 Z</Geometry>
  <Geometry x:Key="IconPrint">M6,8 V3 H18 V8 M6,17 H4 A2,2 0 0 1 2,15 V10 A2,2 0 0 1 4,8 H20 A2,2 0 0 1 22,10 V15 A2,2 0 0 1 20,17 H18 M6,14 H18 V21 H6 Z</Geometry>
  <Geometry x:Key="IconDelete">M5,7 H19 M9,7 V4 H15 V7 M7,7 L8,21 H16 L17,7 M10,11 V17 M14,11 V17</Geometry>
  <Geometry x:Key="IconReverse">M8,7 H19 V18 H8 M8,7 L12,3 M8,7 L12,11 M16,14 H5 V6</Geometry>
  <Geometry x:Key="IconUser">M12,3 A4,4 0 1 0 12,11 A4,4 0 1 0 12,3 M4,21 A8,7 0 0 1 20,21</Geometry>
  <Geometry x:Key="IconUpload">M12,16 V4 M7,9 L12,4 L17,9 M4,15 V21 H20 V15</Geometry>
  <Geometry x:Key="IconBackup">M4,5 H20 V20 H4 Z M7,5 V10 H17 V5 M8,14 H16 V18 H8 Z M2,8 A10,10 0 0 0 4,19</Geometry>
  <Geometry x:Key="IconTheme">M15,3 A9,9 0 1 0 21,17 A7,7 0 0 1 15,3</Geometry>
  <Geometry x:Key="IconClose">M6,6 L18,18 M18,6 L6,18</Geometry>

  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource Bg0Brush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
  </Style>
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>
  <Style TargetType="Label"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style>

  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="{StaticResource CardBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushQ}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,9"/>
    <Setter Property="Margin" Value="4"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
  </Style>
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="#FEF2F2"/>
    <Setter Property="Foreground" Value="#991B1B"/>
    <Setter Property="BorderBrush" Value="{StaticResource RedBrush}"/>
  </Style>

  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Viewbox Width="17" Height="17" Margin="0,0,8,0">
                <Path Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
              </Viewbox>
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.88"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PrimaryIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
  </Style>
  <Style x:Key="DangerIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Setter Property="Background" Value="#FEF2F2"/>
    <Setter Property="Foreground" Value="#991B1B"/>
    <Setter Property="BorderBrush" Value="{StaticResource RedBrush}"/>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="{StaticResource InputBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushQ}"/>
    <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="Margin" Value="4"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="{StaticResource InputBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushQ}"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="Margin" Value="4"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="{StaticResource InputBrush}"/>
    <Setter Property="Padding" Value="10,7"/>
    <Style.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource SelectionTextBrush}"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource SelectionTextBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{StaticResource CardBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushQ}"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrushQ}"/>
    <Setter Property="VerticalGridLinesBrush" Value="{StaticResource BorderBrushQ}"/>
    <Setter Property="RowBackground" Value="{StaticResource CardBrush}"/>
    <Setter Property="AlternatingRowBackground" Value="{StaticResource Bg0Brush}"/>
    <Setter Property="HeadersVisibility" Value="All"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="RowHeight" Value="42"/>
    <Setter Property="ColumnHeaderHeight" Value="42"/>
    <Setter Property="Margin" Value="4"/>
    <Setter Property="SelectionUnit" Value="CellOrRowHeader"/>
  </Style>
  <Style TargetType="DataGridCell">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="6,3"/>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource SelectionTextBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource SidebarBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="8"/>
  </Style>
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="{StaticResource Bg1Brush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushQ}"/>
  </Style>
  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="{StaticResource SidebarBrush}"/>
    <Setter Property="Padding" Value="14,9"/>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="StatusBar">
    <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
  </Style>
  <Style x:Key="CardBorder" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource CardBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushQ}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="14"/>
    <Setter Property="Margin" Value="6"/>
  </Style>
</ResourceDictionary>